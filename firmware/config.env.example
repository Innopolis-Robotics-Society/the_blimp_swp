# ArduMotorBlimp firmware build configuration
# Copy this file to config.env and edit for your environment

# SSH connection to build VM (ignored when using -l / --local)
VM_HOST=my_vm
VM_USER=your_user

# Workspace directory on VM (or local machine)
WORKSPACE=~/blimp_workspace

# ArduMotorBlimp branch to build
VEHICLE_BRANCH=feat/manual-only

# Target board
BOARD=MicoAir743v2
